# App
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173

# JWT
JWT_SECRET=tgfly_change_this_to_a_very_long_random_string_in_production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# MySQL (Local Development)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=tgfly_db

# TeleCloud S3 (Get from Ethio Telecom)
TELECLOUD_ENDPOINT=https://s3.telecloud.ethiotelecom.et
TELECLOUD_REGION=us-east-1
TELECLOUD_ACCESS_KEY=your_access_key_here
TELECLOUD_SECRET_KEY=your_secret_key_here
TELECLOUD_BUCKET=tg-fly-prod

# Google OAuth (Get from console.cloud.google.com)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback
